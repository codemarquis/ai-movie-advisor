# Copy to .env (gitignored) and fill in. On a server: chmod 600 .env

# Web app connection. Use the read-only role from deployment/db_roles.sql.
DATABASE_URL=postgresql://ama_app:change-me@localhost:5432/moviedb

# Admin scripts (init_db, update_posters, import_db) need write access.
# Falls back to DATABASE_URL when unset. Add ?sslmode=require for RDS/managed Postgres.
ADMIN_DATABASE_URL=postgresql://movie_admin:change-me@localhost:5432/moviedb

# Optional: preferred poster source (https://www.themoviedb.org/settings/api)
TMDB_API_KEY=
